ACORN 1.0 IWML 1.0
Features.DataBinding.Advanced.Index
  Data[]
    Data:Purchases
      Text:
        [{"ID":3, "Item":"Rabbit Food", "Amount":29.99, "VendorID":3}
        ,{"ID":1, "Item":"Candy", "Amount":1.50, "VendorID":1}
        ,{"ID":2, "Item":"Toilet Seat", "Amount":99.99, "VendorID":2}
        ,{"ID":4, "Item":"Light Bulbs", "Amount":9.49, "VendorID":1}
        ,{"ID":5, "Item":"Sink", "Amount":75.00, "VendorID":2}]
